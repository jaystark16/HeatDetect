# Copy to `frontend/.env.local` for local overrides (gitignored).
#
# Leave EMPTY in development: the Vite dev server proxies /api to the local
# FastAPI process, so there is no CORS and no hardcoded host.
#
# In production set this to the Render service origin, e.g.
#   VITE_API_BASE=https://heatdetect-api.onrender.com
# Vite inlines it at build time, so the deployment must be rebuilt after a change.
VITE_API_BASE=
