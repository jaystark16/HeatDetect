# Copy this file to `backend/.env` and fill in the real values.
# `.env` is gitignored — it must never be committed.

# --- NASA FIRMS -----------------------------------------------------------
# Request a free key at https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Leave blank in Phase 0; the API serves sample data until this is set.
FIRMS_MAP_KEY=

# --- Database (Phase 2) ---------------------------------------------------
# Neon connection string. Looks like:
#   postgresql://user:password@ep-xxx.region.aws.neon.tech/heatdetect?sslmode=require
# This contains a password — treat it like one.
DATABASE_URL=

# --- Application ----------------------------------------------------------
# Comma-separated origins allowed to call this API from a browser.
CORS_ORIGINS=http://localhost:5173

# Area of interest for FIRMS ingestion: min_lon,min_lat,max_lon,max_lat
# Default is a bounding box covering India.
AREA_BBOX=68.0,6.0,98.0,37.5

# How many days of detections to pull per refresh (FIRMS allows up to 10).
FIRMS_DAY_RANGE=3
