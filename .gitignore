# --- Secrets (never commit) ---
.env
.env.local
.env.*.local
*.pem
*_MAP_KEY*

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Node ---
node_modules/
dist/
dist-ssr/
*.local
.vite/

# --- Database: regenerable from the pipeline, so not tracked ---
# `python -m app.pipeline ingest && features` rebuilds it in under a minute.
backend/data/*.db
backend/data/*.db-journal
backend/data/*.db-wal

# --- Deliberately TRACKED, listed here so the intent is explicit ---
# backend/data/osm_cache/*.json.gz
#   Overpass is rate-limited and slow (~30s/tile, frequent 504s). Committing the
#   cache means a fresh clone, CI and a live demo need no Overpass access.
#   ~1 MiB gzipped for 30 tiles.
# backend/models/single_observation_rf.joblib
#   The deployed API needs a model and the training database is not tracked.
#   2.4 MiB compressed.
# frontend/public/snapshot.json
#   Real pipeline output, so the static Pages deployment works with no backend.

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
